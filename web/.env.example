NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only
FASTAPI_INTERNAL_BASE_URL=http://localhost:8000
OWNER_ADMIN_EMAILS=
BILLING_INTERNAL_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Defaults are lookup keys:
# agent_oze_monthly_399.
# You can override with either a Stripe price ID (price_...) or another lookup key.
STRIPE_PRICE_MONTHLY=agent_oze_monthly_399

# === Security headers (lib/security-headers.mjs) — staged rollout, see docs/SECURITY.md ===
# CSP ships as Report-Only until this is "true". Flip ONLY after a deploy shows
# no CSP violations in the browser console.
CSP_ENFORCE=
# HSTS ramp. Default 86400 (1 day). Raise to 15552000 (180d), then enable
# includeSubDomains (all subdomains must be HTTPS), then preload (hard to undo).
HSTS_MAX_AGE=
HSTS_INCLUDE_SUBDOMAINS=
HSTS_PRELOAD=
